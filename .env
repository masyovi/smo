# SMO (Save My Office) — Turso (libsql) database
# Use a dedicated env var name (TURSO_DATABASE_URL) so the shell's
# DATABASE_URL override doesn't shadow this connection.
# The auth token is embedded in the URL query string (?authToken=)
# so both the Prisma CLI (db:push) and the runtime libsql adapter work.
TURSO_DATABASE_URL="libsql://smoid-gedung.aws-ap-northeast-1.turso.io?authToken=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTEyOTYyMjcsImlkIjoiMDFhMTExNTctZTEwMS03ODlkLWJjYzYtOGRhMDY3ZTQyODkwIiwia2lkIjoiTVJVUkhVMmg5c2s2b0h6cVR4SUhGT0VuSllQc20zYUFpdjFQUVItNGtZTSIsInJpZCI6IjkwMmIwN2E3LTZmNTEtNGVmNi1iMDYzLWZlOWEwNGJiZWU2MCJ9.BLO-_CNW7VFWdIWTBI5JtB6pFIvQLRgX6tiIBOxkrwYNPjosMckbaZy-_m8xB_zBsxwa8eI7i3nhukV3M1bQBg"
SESSION_SECRET=smo-super-secret-key-change-in-production-2024

# Kept for compatibility with any code that still reads DATABASE_URL
# (the runtime prefers TURSO_DATABASE_URL above).
DATABASE_URL=file:/home/z/my-project/db/smoid.db
